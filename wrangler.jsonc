{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felis-noetica",
  "main": "worker.js",
  "compatibility_date": "2026-08-08",
  "routes": [
    {
      "pattern": "felisnoetica.cz",
      "custom_domain": true
    },
    {
      "pattern": "www.felisnoetica.cz",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node nastroje/build.js"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
