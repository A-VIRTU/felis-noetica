{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felis-noetica",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      ".github",
      ".github/**"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
